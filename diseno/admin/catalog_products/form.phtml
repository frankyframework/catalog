<script >
$(document).ready(function()
{
  $( "#frmproduct" ).validate({
    submitHandler: function(form) {
      $('.ui-search-toolbar').find('input,select').prop('disabled', true);
      return true;
    }
  });
  $('.save-form-top').click(function(e){
      e.preventDefault();
      $('#frmproduct').trigger('submit');
  });
  $('textarea[name=meta_keyword]').tagsInput({width:'auto'});
  $('input[name=videos]').tagsInput({width:'auto'});


  $('select[name="set_attribute"]').change(function(){
      ajax_getCatalogCustomAttrFrm(window.productId );
  });
  ajax_getCatalogCustomAttrFrm(window.productId );

  if($('#jqGrid').length) {
    var mobileRelatedGrid = ($(window).width() <= 767);
    function buildRelatedColumns() {
      return [
        {label:'ID BACK',name:'id',key:true,hidden:true,width:50},
        {label:'STATUS BACK',name:'status',hidden:true,width:50},
        {label:'STORE ID',name:'store_id',hidden:true,width:50},
        {label:'ID',name:'_id',hidden:mobileRelatedGrid,width:100},
        {label:'Thumb',name:'images',hidden:mobileRelatedGrid,width:100,search:false},
        {label:'Nombre',name:'name',width:250},
        {label:'SKU',name:'sku',width:250},
        {name:'acciones',index:'acciones',width:200,align:'center',sortable:false,search:false,formatter:relatedProductButton}
      ];
    }
    $('#jqGrid').GridAdmin({search:true,entity:'catalog_rel'+window.relatedGridQuery,redirectOnSelectRow:false,gridPager:'#jqGridPager',btnSearch:'#btsSearchRelatedGrid',redirectPath:'',pathData:window.relatedGridPath,error:'No hay productos registrados',callbackFuncion:'bindRelatedProductButtons',colModel:buildRelatedColumns(),subGrid:mobileRelatedGrid,subGridRowExpanded:showRelatedProductChild,width:920,removeUrlTop:false});
    $('#jqGridRel').GridAdmin({search:false,entity:'catalog_rel_true'+window.relatedGridQuery,redirectOnSelectRow:false,gridPager:'#jqGridPagerRel',btnSearch:'',redirectPath:'',pathData:window.relatedGridPathRel,error:'No hay productos relacionados',callbackFuncion:'bindRelatedProductButtons',colModel:buildRelatedColumns(),subGrid:mobileRelatedGrid,subGridRowExpanded:showRelatedProductChild,width:920,removeUrlTop:false});
  }

});

window.stageRelatedProduct = function(id, selected) {
  var ids = JSON.parse($('#related-products-value').val() || '[]').map(String);
  id = String(id);
  if(selected && ids.indexOf(id) === -1) ids.push(id);
  if(!selected) ids = ids.filter(function(value) { return value !== id; });
  $('#related-products-value').val(JSON.stringify(ids));

  // Actualizar el grid seleccionado directamente para que no dependa del filtro del otro grid.
  if(selected) {
    var candidate = window.relatedProductRows[id];
    if(candidate && $('#jqGridRel').jqGrid('getDataIDs').indexOf(candidate.id) === -1) {
      candidate.status = 'desactivar';
      $('#jqGridRel').jqGrid('addRowData', candidate.id, candidate, 'last');
    }
  } else {
    var selectedIds = $('#jqGridRel').jqGrid('getDataIDs');
    for(var j = 0; j < selectedIds.length; j++) {
      var related = $('#jqGridRel').jqGrid('getRowData', selectedIds[j]);
      if(String(related._id) === id) $('#jqGridRel').jqGrid('delRowData', selectedIds[j]);
    }
  }

  window.refreshRelatedProductGridUrls(ids);
  ajax_products_setRelacionadoPendiente(window.album, id, selected ? 1 : 0);
};

window.refreshRelatedProductGridUrls = function(ids) {
  var query = '&id=' + encodeURIComponent(window.relatedParentId) +
    '&draftKey=' + encodeURIComponent(window.relatedDraftKey) +
    '&draftIds=' + encodeURIComponent(ids.join(','));
  $('#jqGrid').jqGrid('setGridParam', {url: window.relatedGridPath + '?callback=?&qwery=catalog_rel' + query});
  $('#jqGridRel').jqGrid('setGridParam', {url: window.relatedGridPathRel + '?callback=?&qwery=catalog_rel_true' + query});
};

function relatedProductButton(cellvalue, options, row) {
  window.relatedProductRows[String(row._id)] = row;
  return '<a class="btn_adm_relacionar btn_adm_relacionar_product_mp_switch" data-id="'+row._id+'" href="#'+row.status+'"></a>';
}
function bindRelatedProductButtons() {
  $.fn.buttonDelete('a.btn_adm_relacionar_product_mp_switch');
  $('#related-products-section .btn_adm_relacionar').off('click').on('click', function(event) {
    event.preventDefault();
    var selected = $(this).attr('href').replace('#','') === 'activar';
    window.stageRelatedProduct($(this).attr('data-id'), selected);
  });
}
function showRelatedProductChild(rowId) {
  if($(window).width() <= 767) $('#'+rowId).append('<p>'+$('#'+rowId+' td[aria-describedby$="_images"]').html()+'</p>');
}
</script>
<script>
function uploadMultiGaleria(e)
{
    var files;
    if(e.originalEvent.dataTransfer) {
      files = e.originalEvent.dataTransfer.files;
    } else if(e.target) {
      files = e.originalEvent.target.files;
    }

    var fd = new FormData();

    fd.append('album',window.album); 
    for (var i = 0; i < files.length; i++) { // Loop all files
            fd.append('images[]', files[i]); // Create an append() method, one for each file dropped
    }

     var progressbar = $( "#progressbar" ),  progressLabel = $( ".progress-label" );
    progressbar.progressbar({
        value: false,
        change: function() {
          progressLabel.text( progressbar.progressbar( "value" ) + "%" );
        },
        complete: function() {
          progressLabel.text( "Completo!" );
        }
    });

    $.ajax({ // JQuery Ajax
            type: 'POST',
            url: "/admin/catalog_products/upload.php", // URL to the PHP file which will insert new value in the database
            data:fd, // We send the data string
            processData: false,
            contentType: false,
            mimeType:"multipart/form-data",
            beforeSend:function(){
                progressbar.show();
                $("#imageloadbutton").hide();
            },
            success:function(response){

               progressbar.show();

                $("#imageloadbutton").show();


                $("#photoimg").val('');

                var respuesta = null;

                if(response != "null")
                {


                  $(".no_hay_datos").hide();

                  respuesta = JSON.parse(response);
                  for(var  i=0; i < respuesta['img'].length; i++)
                  {
                      $("#cont_fotos").append(respuesta['img'][i]["html"]);
                  }
                  sortGaleria();
                }


            },
            error:function(){

                $("#imageloadbutton").show();
            },
            xhr: function () {
                var xhr = $.ajaxSettings.xhr();
                if(xhr.upload){
                xhr.upload.addEventListener("progress", function (e) {
                            if (e.lengthComputable) {
                                    var pourc = Math.round(e.loaded / e.total * 100);
                                     progressbar.progressbar( "value", pourc );
                            }


                    } , false);
                }
                return xhr;
            },

    });

}
$(document).ready(function()
{
    $('#photoimg').on('change', function(e)
    {
        uploadMultiGaleria(e);
       
    });
    sortGaleria();

});


var sortGaleria = function() {
      var gallery = $("#cont_fotos");
      if(!gallery.length) return;
      if(gallery.hasClass('ui-sortable')) {
          gallery.sortable('refresh');
      } else {
          gallery.sortable({
              items: '> .img_foto_clientes',
              connectWith: ".fondo_galeria",
              update: function(){
                  var newOrder = $(this).sortable('toArray').toString();
                  setOrdenImagesProducts(window.album,newOrder);
              },
              placeholder: 'ui-state-default'
          });
      }
      gallery.disableSelection();
    }
    
</script>
